.card-scene {
  position: relative;
  width: 100%;
  height: 540rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 24rpx;
  line-height: 1.5;
  color: #3e3554;
  perspective: 1400rpx;
}

.card-scene view,
.card-scene text {
  box-sizing: border-box;
}

.card-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.52s cubic-bezier(0.2, 0.8, 0.3, 1);
  will-change: transform;
}

.card-inner.is-flipped {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
}

.face {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 36rpx rgba(76, 58, 38, 0.16);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* ---------- 正面 ---------- */
.front {
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
}

/* 彩色标题带：用同色系深色 tone，白字对比清晰 */
.front-head {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx 22rpx;
  overflow: hidden;
}

.head-glow {
  position: absolute;
  top: -96rpx;
  right: -46rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 50%;
}

.name-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.card-name {
  display: block;
  overflow: hidden;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.group-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.55);
}

.meta-text {
  color: rgba(255, 255, 255, 0.92);
  font-size: 21rpx;
  font-weight: 600;
}

.badge-mortgaged {
  margin-left: 12rpx;
  padding: 3rpx 14rpx;
  color: #b3352d;
  font-size: 19rpx;
  font-weight: 800;
  background: #ffe2de;
  border-radius: 999rpx;
}

.price-pill {
  position: relative;
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 14rpx rgba(40, 30, 20, 0.18);
}

.price-symbol {
  margin-right: 2rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.price-num {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.front-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 22rpx 30rpx 22rpx;
  background: #ffffff;
}

.intro {
  display: -webkit-box;
  flex: 1;
  margin-bottom: 16rpx;
  overflow: hidden;
  color: #5d5349;
  font-size: 23rpx;
  line-height: 1.6;
  text-overflow: ellipsis;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.money-grid {
  display: flex;
  flex-shrink: 0;
}

.money-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
}

.money-cell + .money-cell {
  margin-left: 14rpx;
}

.money-label {
  color: #7a6e63;
  font-size: 20rpx;
  font-weight: 600;
}

.money-value {
  margin-top: 2rpx;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.front-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 18rpx;
}

.level-chip {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 17rpx;
  font-size: 20rpx;
  font-weight: 800;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

.level-chip text + text {
  margin-left: 6rpx;
}

.flip-hint {
  color: #a0958a;
  font-size: 19rpx;
  font-weight: 600;
}

/* ---------- 背面 ---------- */
.back {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
}

.back-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  height: 102rpx;
  padding: 0 30rpx;
  overflow: hidden;
  color: #ffffff;
}

.back-head-text {
  position: relative;
  display: flex;
  flex-direction: column;
}

.back-name {
  font-size: 33rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.back-sub {
  margin-top: 2rpx;
  font-size: 19rpx;
  font-weight: 600;
  opacity: 0.88;
}

.back-mortgaged {
  position: relative;
  padding: 5rpx 16rpx;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
}

.back-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 14rpx 26rpx 0;
  background: #ffffff;
}

.toll-list {
  padding: 2rpx 0;
}

.toll-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 43rpx;
  padding: 0 14rpx;
  color: #6d6157;
  font-size: 22rpx;
  border-radius: 13rpx;
}

.toll-row.is-active {
  font-weight: 900;
}

.toll-label-wrap {
  display: flex;
  align-items: center;
}

.toll-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 9rpx;
  border-radius: 50%;
}

.toll-value {
  font-variant-numeric: tabular-nums;
}

.build-row {
  display: flex;
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  margin-top: 8rpx;
  border-radius: 20rpx;
}

.build-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.build-cell + .build-cell {
  padding-left: 16rpx;
  border-left: 2rpx dashed rgba(120, 105, 92, 0.2);
}

.build-label {
  color: #7a6e63;
  font-size: 19rpx;
  font-weight: 600;
}

.build-value {
  font-size: 24rpx;
  font-weight: 900;
}

.back-note {
  margin-top: 8rpx;
  color: #a2968a;
  font-size: 18rpx;
  text-align: center;
}

.rule-list {
  flex: 1;
  padding-top: 10rpx;
}

.rule-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  color: #5d5349;
  font-size: 22rpx;
  line-height: 1.45;
}

.rule-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

.rule-text {
  flex: 1;
}

.back-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 8rpx 0 16rpx;
  margin-top: auto;
}

/* ---------- 平板 / 大屏 ----------
 * 卡牌在平板上按两列或三列排布，用固定 px 密度避免 rpx 放大后溢出。
 */
@media (min-width: 600px) {
  .card-scene {
    height: 340px;
    font-size: 13px;
    perspective: 1000px;
  }

  .face {
    border-radius: 24px;
    box-shadow: 0 10px 24px rgba(76, 58, 38, 0.14);
  }

  .front-head {
    padding: 14px 18px 13px;
  }

  .head-glow {
    top: -64px;
    right: -32px;
    width: 170px;
    height: 170px;
  }

  .name-wrap {
    padding-right: 12px;
  }

  .card-name {
    font-size: 23px;
    letter-spacing: 1px;
  }

  .meta-row {
    margin-top: 6px;
  }

  .group-dot {
    width: 10px;
    height: 10px;
    margin-right: 7px;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.55);
  }

  .meta-text {
    font-size: 12px;
  }

  .badge-mortgaged {
    margin-left: 8px;
    padding: 2px 9px;
    font-size: 11px;
  }

  .price-pill {
    padding: 6px 13px;
    border-radius: 14px;
    box-shadow: 0 4px 9px rgba(40, 30, 20, 0.16);
  }

  .price-symbol {
    font-size: 13px;
  }

  .price-num {
    font-size: 20px;
    letter-spacing: 0;
  }

  .front-body {
    padding: 14px 18px 14px;
  }

  .intro {
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.55;
    -webkit-line-clamp: 3;
  }

  .money-cell {
    padding: 9px 11px;
    border-radius: 14px;
  }

  .money-cell + .money-cell {
    margin-left: 9px;
  }

  .money-label {
    font-size: 11px;
  }

  .money-value {
    margin-top: 1px;
    font-size: 19px;
    letter-spacing: 0;
  }

  .front-footer {
    padding-top: 12px;
  }

  .level-chip {
    padding: 4px 10px;
    font-size: 11px;
    border-width: 1px;
  }

  .flip-hint {
    font-size: 11px;
  }

  .back-head {
    height: 60px;
    padding: 0 18px;
  }

  .back-name {
    font-size: 20px;
    letter-spacing: 0;
  }

  .back-sub {
    margin-top: 1px;
    font-size: 11px;
  }

  .back-mortgaged {
    padding: 3px 10px;
    font-size: 11px;
    border-width: 1px;
  }

  .back-body {
    padding: 8px 16px 0;
  }

  .toll-list {
    padding: 1px 0;
  }

  .toll-row {
    height: 28px;
    padding: 0 9px;
    font-size: 13px;
    border-radius: 8px;
  }

  .toll-dot {
    width: 7px;
    height: 7px;
    margin-right: 6px;
  }

  .build-row {
    padding: 6px 10px;
    margin-top: 6px;
    border-radius: 12px;
  }

  .build-cell + .build-cell {
    padding-left: 10px;
    border-left-width: 1px;
  }

  .build-label {
    font-size: 11px;
  }

  .build-value {
    font-size: 14px;
  }

  .back-note {
    margin-top: 5px;
    font-size: 11px;
  }

  .rule-list {
    padding-top: 6px;
  }

  .rule-line {
    margin-bottom: 6px;
    font-size: 13px;
    line-height: 1.4;
  }

  .rule-dot {
    width: 7px;
    height: 7px;
    margin-top: 7px;
    margin-right: 6px;
  }

  .back-footer {
    padding: 6px 0 10px;
  }
}
