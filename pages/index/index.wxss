.home-page {
  padding-top: 24rpx;
}

/* ---------- 顶部卡通头图 ---------- */
.hero {
  position: relative;
  padding: 34rpx 34rpx 32rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffe2a8 0%, #ffc9a9 56%, #ffd9c6 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 46rpx;
  box-shadow: 0 18rpx 38rpx rgba(240, 150, 98, 0.2);
}

.hero-bubble {
  position: absolute;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 50%;
}

.bubble-a {
  top: -70rpx;
  right: -50rpx;
  width: 210rpx;
  height: 210rpx;
}

.bubble-b {
  bottom: -50rpx;
  left: -30rpx;
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
}

.bubble-c {
  top: 120rpx;
  right: 150rpx;
  width: 34rpx;
  height: 34rpx;
  background: rgba(255, 255, 255, 0.35);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-copy {
  padding-right: 18rpx;
}

.hero-kicker {
  display: inline-block;
  padding: 5rpx 16rpx;
  color: #a85c32;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  background: rgba(255, 255, 255, 0.56);
  border-radius: 999rpx;
}

.hero-title {
  margin-top: 14rpx;
  color: #5a3a2a;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.15;
}

.hero-sub {
  margin-top: 10rpx;
  color: #8b5a3f;
  font-size: 23rpx;
  font-weight: 600;
}

.count-pill {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  color: #9c5a37;
  font-size: 23rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.66);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
}

.hero-side {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
}

.sync-pill {
  padding: 7rpx 18rpx;
  margin-top: 10rpx;
  color: #2f7d63;
  font-size: 21rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(120, 150, 130, 0.14);
}

.add-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  margin-top: 30rpx;
  color: #f2714b;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  background: #fffdf8;
  border-radius: 47rpx;
  box-shadow: 0 12rpx 24rpx rgba(200, 110, 60, 0.18);
}

.add-btn.is-full {
  color: #a87559;
  background: rgba(255, 253, 248, 0.72);
  box-shadow: 0 8rpx 18rpx rgba(200, 110, 60, 0.1);
}

.add-plus {
  margin-right: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

/* ---------- 玩家列表 ---------- */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 18rpx;
}

.list-title {
  color: #4a3f5c;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.list-tip {
  color: #b1a69b;
  font-size: 21rpx;
}

.player-list {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
}

.player-card {
  position: relative;
  display: block;
  width: 48.6%;
  padding: 18rpx 16rpx 16rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 2rpx solid #fff0de;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(108, 83, 48, 0.08);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.card-top {
  display: flex;
  align-items: center;
}

.card-hover {
  opacity: 0.94;
  transform: scale(0.985);
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(108, 83, 48, 0.12);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.name-wrap {
  flex: 1;
  min-width: 0;
  padding: 0 54rpx 0 12rpx;
}

.player-name {
  display: block;
  overflow: hidden;
  color: #3e3554;
  font-size: 27rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.money-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.stat-chip {
  padding: 4rpx 10rpx;
  margin: 0 6rpx 4rpx 0;
  color: #8b7f75;
  font-size: 18rpx;
  font-weight: 700;
  background: #fff7ec;
  border-radius: 999rpx;
}

.stat-chip.is-debt {
  color: #d4534b;
  background: #fff0ee;
}

.stat-chip.is-clear {
  color: #3f8a5a;
  background: #eef7f0;
}

/* ---------- 卡片内城市 / 欠款信息 ---------- */
.card-section {
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 2rpx dashed #f4e7d7;
}

.card-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.section-label {
  color: #6b5b4e;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.section-side {
  color: #a89c90;
  font-size: 17rpx;
  font-weight: 700;
}

.section-side.is-debt {
  color: #d4534b;
}

.city-group {
  margin-top: 8rpx;
}

.city-group:first-child {
  margin-top: 0;
}

.group-line {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 6rpx;
  border-radius: 50%;
}

.group-name {
  color: #8b7f75;
  font-size: 18rpx;
  font-weight: 800;
}

.group-count {
  margin-left: 6rpx;
  color: #c3b6a8;
  font-size: 16rpx;
}

.city-tags {
  display: flex;
  flex-wrap: wrap;
}

.city-tag {
  display: flex;
  align-items: baseline;
  padding: 4rpx 8rpx;
  margin: 0 6rpx 6rpx 0;
  background: #fffdfa;
  border: 2rpx solid #f0e2d1;
  border-radius: 10rpx;
}

.city-name {
  color: #4a3f5c;
  font-size: 20rpx;
  font-weight: 900;
}

.city-level {
  margin-left: 4rpx;
  color: #8b7f75;
  font-size: 17rpx;
  font-weight: 700;
}

.section-empty {
  padding: 4rpx 0;
  color: #b1a69b;
  font-size: 19rpx;
}

.debt-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 10rpx;
  margin-top: 6rpx;
  background: #fff7f3;
  border-radius: 10rpx;
}

.debt-line:first-child {
  margin-top: 0;
}

.debt-to {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #7a6a5e;
  font-size: 19rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.debt-amount {
  flex-shrink: 0;
  margin-left: 6rpx;
  color: #d4534b;
  font-size: 20rpx;
  font-weight: 900;
}

.debt-clear {
  padding: 6rpx 10rpx;
  color: #3f8a5a;
  font-size: 19rpx;
  font-weight: 700;
  background: #eef7f0;
  border-radius: 10rpx;
}

.delete-fab {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  color: #cbb9a7;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  background: #fff8ef;
  border-radius: 50%;
}

/* ---------- 空状态 ---------- */
.empty-state {
  padding: 54rpx 40rpx 60rpx;
  margin-top: 20rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.82);
  border: 3rpx dashed #f1dfc8;
  border-radius: 44rpx;
}

.empty-art {
  position: relative;
  width: 300rpx;
  height: 250rpx;
  margin: 0 auto;
}

.empty-board {
  position: absolute;
  top: 34rpx;
  left: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 196rpx;
  height: 180rpx;
  font-size: 96rpx;
  background: linear-gradient(145deg, #e7f4ff, #d8ecff);
  border: 6rpx solid #ffffff;
  border-radius: 42rpx;
  box-shadow: 0 16rpx 30rpx rgba(86, 125, 168, 0.16);
  transform: rotate(-6deg);
}

.empty-face {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  font-size: 58rpx;
  background: #ffe2c4;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 10rpx 22rpx rgba(200, 130, 80, 0.16);
}

.empty-cloud {
  position: absolute;
  top: 0;
  left: 0;
  font-size: 46rpx;
  opacity: 0.9;
}

.empty-spark {
  position: absolute;
  top: 40rpx;
  right: 16rpx;
  font-size: 34rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #4a3f5c;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-text {
  margin-top: 12rpx;
  color: #a89c90;
  font-size: 25rpx;
}

/* ---------- 底部清空 ---------- */
.clear-all {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  color: #d4534b;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  background: #fff0ee;
  border: 2rpx solid #ffd3cd;
  border-radius: 44rpx;
}

/* ---------- 平板 / 大屏 ---------- */
@media (min-width: 600px) {
  .home-page {
    padding-top: 16px;
  }

  .hero {
    padding: 24px 28px 26px;
    margin-bottom: 20px;
    border-width: 3px;
    border-radius: 30px;
    box-shadow: 0 12px 26px rgba(240, 150, 98, 0.16);
  }

  .bubble-a {
    top: -44px;
    right: -30px;
    width: 150px;
    height: 150px;
  }

  .bubble-b {
    bottom: -34px;
    left: -20px;
    width: 96px;
    height: 96px;
  }

  .bubble-c {
    top: 80px;
    right: 110px;
    width: 22px;
    height: 22px;
  }

  .hero-kicker {
    padding: 3px 10px;
    font-size: 11px;
    letter-spacing: 2px;
  }

  .hero-title {
    margin-top: 10px;
    font-size: 34px;
    letter-spacing: 2px;
  }

  .hero-sub {
    margin-top: 6px;
    font-size: 14px;
  }

  .count-pill {
    padding: 5px 13px;
    font-size: 14px;
    border-width: 1px;
  }

  .sync-pill {
    padding: 5px 12px;
    margin-top: 8px;
    font-size: 13px;
    border-width: 1px;
  }

  .add-btn {
    height: 52px;
    margin-top: 20px;
    font-size: 17px;
    border-radius: 26px;
    box-shadow: 0 8px 18px rgba(200, 110, 60, 0.16);
  }

  .add-plus {
    margin-right: 6px;
    font-size: 24px;
  }

  .list-head {
    padding: 0 4px;
    margin-bottom: 12px;
  }

  .list-title {
    font-size: 19px;
  }

  .list-tip {
    font-size: 12px;
  }

  /* 每行固定两张卡，顺序按行排列；卡片高度随内容变化，不拉伸 */
  .player-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    align-items: start;
  }

  .player-card {
    display: block;
    width: 100%;
    padding: 14px 14px 12px;
    margin-bottom: 0;
    border-width: 1px;
    border-radius: 20px;
    box-shadow: 0 6px 16px rgba(108, 83, 48, 0.07);
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-width: 2px;
    box-shadow: 0 2px 6px rgba(108, 83, 48, 0.12);
  }

  .avatar-emoji {
    font-size: 20px;
  }

  .name-wrap {
    padding: 0 26px 0 8px;
  }

  .player-name {
    font-size: 15px;
  }

  .money-row {
    margin-top: 8px;
  }

  .stat-chip {
    padding: 2px 7px;
    margin: 0 4px 4px 0;
    font-size: 11px;
  }

  .card-section {
    padding-top: 8px;
    margin-top: 8px;
    border-top-width: 1px;
  }

  .card-section-head {
    margin-bottom: 6px;
  }

  .section-label {
    font-size: 12px;
  }

  .section-side {
    font-size: 10px;
  }

  .city-group {
    margin-top: 6px;
  }

  .group-line {
    margin-bottom: 4px;
  }

  .group-dot {
    width: 7px;
    height: 7px;
    margin-right: 4px;
  }

  .group-name {
    font-size: 11px;
  }

  .group-count {
    margin-left: 4px;
    font-size: 10px;
  }

  .city-tag {
    padding: 2px 6px;
    margin: 0 4px 4px 0;
    border-width: 1px;
    border-radius: 7px;
  }

  .city-name {
    font-size: 11px;
  }

  .city-level {
    margin-left: 3px;
    font-size: 10px;
  }

  .section-empty {
    font-size: 11px;
  }

  .debt-line {
    padding: 4px 7px;
    margin-top: 4px;
    border-radius: 7px;
  }

  .debt-to {
    font-size: 11px;
  }

  .debt-amount {
    margin-left: 4px;
    font-size: 11px;
  }

  .debt-clear {
    padding: 4px 7px;
    font-size: 11px;
    border-radius: 7px;
  }

  .delete-fab {
    top: 6px;
    right: 6px;
    width: 26px;
    height: 26px;
    font-size: 16px;
  }

  .empty-state {
    padding: 36px 28px 40px;
    margin-top: 14px;
    border-width: 2px;
    border-radius: 28px;
  }

  .empty-art {
    width: 210px;
    height: 175px;
  }

  .empty-board {
    top: 24px;
    left: 36px;
    width: 138px;
    height: 126px;
    font-size: 66px;
    border-width: 4px;
    border-radius: 28px;
    box-shadow: 0 10px 20px rgba(86, 125, 168, 0.14);
  }

  .empty-face {
    bottom: 2px;
    width: 82px;
    height: 82px;
    font-size: 40px;
    border-width: 3px;
  }

  .empty-cloud {
    font-size: 32px;
  }

  .empty-spark {
    top: 28px;
    right: 10px;
    font-size: 24px;
  }

  .empty-title {
    margin-top: 16px;
    font-size: 20px;
  }

  .empty-text {
    margin-top: 8px;
    font-size: 15px;
  }

  .clear-all {
    height: 48px;
    font-size: 15px;
    background: #fff0ee;
    border-width: 1px;
    border-radius: 24px;
  }
}

@media (min-width: 1000px) {
  .hero-title {
    font-size: 36px;
  }
}
